# Build artifacts
*.o
*.a
*.so
*.so.*
*.xbps
*.xbps.sig*
*.xbps.sig2

# Suckless / local installs
suckless/**/config.h.bak
suckless/**/colors.h
!suckless/**/colors.h.in
suckless/**/dwm
suckless/**/st
suckless/**/dmenu
