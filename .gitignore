# Build artifacts
*.o
*.a
*.so
*.so.*
*.xbps
*.xbps.sig*
*.xbps.sig2

# Suckless build outputs only (not source directories)
suckless/**/config.h.bak
suckless/dwm/dwm
suckless/st/st
suckless/dmenu/dmenu
suckless/dmenu/stest
# theme may dirty colors.h; default colors.h is tracked
# man pages are tracked from upstream tarballs

# Generated theme state (user machines; not committed)
.voidwolf-generated/
**/generated/

# Editor / OS
*~
*.swp
*.swo
.DS_Store
.idea/
.vscode/
*.code-workspace

# Logs and local bootstrap state
*.log
bootstrap/bootstrap.log
bootstrap/.local-state/

# Python / tooling
__pycache__/
*.pyc
.venv/
venv/

# ISO build output
iso/out/
iso/work/
*.iso

# Local XBPS hostrepo workdirs
packages/*/destdir/
packages/*/work/

# Secrets / local overrides
.env
.env.*
*.local.conf
