**/generated/

# Editor / OS
*~
*.swp
*.swo
.DS_Store
.idea/
.vscode/
*.code-workspace

# Logs and local bootstrap state
*.log
bootstrap/bootstrap.log
bootstrap/.local-state/

# Python / tooling
__pycache__/
*.pyc
.venv/
venv/

# ISO build output
iso/out/
iso/work/
*.iso

# Local XBPS hostrepo workdirs
packages/*/destdir/
packages/*/work/

# Secrets / local overrides
.env
.env.*
*.local.conf
