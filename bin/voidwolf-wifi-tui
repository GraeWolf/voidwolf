#!/bin/sh
# Super+Ctrl+W — network / Wi-Fi
export PATH="${HOME}/.local/bin:${PATH}"

if command -v nmtui >/dev/null 2>&1; then
	exec st -t "network" -e nmtui
fi
if command -v nmcli >/dev/null 2>&1; then
	exec st -t "network" -e sh -c 'nmcli dev wifi list; echo; nmcli c show; echo; echo "[enter]"; read -r _'
fi
echo "voidwolf-wifi-tui: NetworkManager tools not found" >&2
exit 1
