#!/bin/sh
# Handler for dwm statuscmd clicks.
# Env: BUTTON = 1..5. Arg: section name (updates|volume).
export PATH="${HOME}/.local/bin:${PATH}"

section="${1:-}"
btn="${BUTTON:-1}"

# Force a quick bar redraw after volume changes (status loop is 1s)
kick_status() {
	# best-effort: if status holds flock, next tick is soon; also poke root name
	# by running a one-shot volume line update is hard; touch a wake file
	: >"${XDG_RUNTIME_DIR:-/tmp}/voidwolf-status.wake" 2>/dev/null || true
}

case "$section" in
	updates)
		case "$btn" in
			1|2|3)
				if command -v voidwolf-float-term >/dev/null 2>&1; then
					exec voidwolf-float-term updates -- voidwolf-updates-tui
				fi
				exec st -t "voidwolf-tui:updates" -g 100x30 -e voidwolf-updates-tui
				;;
		esac
		;;
	volume)
		case "$btn" in
			4)
				voidwolf-volume up 2>/dev/null || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
				kick_status
				;;
			5)
				voidwolf-volume down 2>/dev/null || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
				kick_status
				;;
			1|2|3)
				if command -v voidwolf-audio-tui >/dev/null 2>&1; then
					exec voidwolf-audio-tui
				fi
				;;
		esac
		;;
	*)
		exit 0
		;;
esac
