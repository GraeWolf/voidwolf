#!/bin/sh
# voidwolf-cheatsheet — Super+K searchable keybind help
# Prefer fzf in a floating centered st; fall back to dmenu.
export PATH="${HOME}/.local/bin:${PATH}"

# Lines: "KEYBIND<TAB>Action description"  (human-facing only)
binds() {
	cat <<'EOF'
Super+Return	Terminal
Super+Shift+B	Browser
Super+Space	App launcher
Super+Alt+Space	Control menu
Super+Escape	System menu
Super+Ctrl+L	Lock screen
Super+Shift+N	Neovim
Super+Shift+F	File manager (Nemo)
Super+K	This keybind cheatsheet
Super+Ctrl+Shift+Space	Theme picker
Super+Ctrl+Space	Wallpaper picker
Super+W	Close window
Super+T	Toggle floating
Super+F	Fullscreen
Super+B	Toggle bar
Super+Shift+Space	Toggle bar
Super+Z	Zoom (swap master)
Super+Shift+Q	Quit X session
Super+Ctrl+Shift+Q	Restart dwm
Super+H / Super+Left	Focus left
Super+L / Super+Right	Focus right
Super+J / Super+Down	Focus down
Super+Up	Focus up
Alt+Tab	Next window in stack
Alt+Shift+Tab	Previous window in stack
Super+Shift+H/J/Arrows	Move window in stack
Super+Shift+L	Cycle layouts forward
Super+Ctrl+Shift+L	Cycle layouts reverse
Super+M	Monocle layout
Super+Shift+T	Tile layout
Super+I / Super+D	Increase / decrease masters
Super+= / Super+-	Grow / shrink master
Super+S	Toggle scratchpad
Super+O	Toggle sticky
Super+G	Toggle gaps
Super+Shift+G	Reset gaps
Super+Ctrl+= / Super+Ctrl+-	Increase / decrease gaps
Super+1…9	View tag
Super+Shift+1…9	Move window to tag
Super+Ctrl+1…9	Toggle view tag
Super+Ctrl+Shift+1…9	Toggle window tag
Super+0	View all tags
Super+Shift+0	Tag all
Super+Tab	Next tag set
Super+Shift+Tab	Previous tag set
Super+Ctrl+Tab	Toggle last tag set
Super+.	Focus next monitor
Super+Ctrl+.	Focus previous monitor
Super+Shift+.	Send window to next monitor
Super+Ctrl+Shift+.	Send window to previous monitor
Super+Shift+P	Full screenshot
Super+Shift+S	Region screenshot
Super+Ctrl+C	Screenshot menu
Super+Ctrl+V	Clipboard menu
Print	Full screenshot (if key exists)
Shift+Print	Region screenshot (if key exists)
Super+,	Dismiss notification
Super+Shift+,	Dismiss all notifications
Super+Ctrl+,	Toggle notification silence
Super+Alt+,	Notification history
Super+Ctrl+A	Audio TUI
Super+Ctrl+B	Bluetooth TUI
Super+Ctrl+W	Wi-Fi TUI
Super+Ctrl+T	btop
XF86 AudioRaiseVolume	Volume up
XF86 AudioLowerVolume	Volume down
XF86 AudioMute	Mute toggle
XF86 MonBrightnessUp	Brightness up
XF86 MonBrightnessDown	Brightness down
Super+Btn1	Move window
Super+Btn3	Resize window
Super+Btn2	Toggle floating
EOF
}

# Pretty fixed-width for display: key left, action right
format_list() {
	binds | awk -F'	' '{
		key=$1; act=$2;
		printf "%-28s  %s\n", key, act
	}'
}

run_fzf() {
	format_list | fzf \
		--prompt='keybinds> ' \
		--height=100% \
		--layout=reverse \
		--border \
		--info=inline \
		--bind='enter:accept' \
		--header='Type to filter · Enter to dismiss' \
		>/dev/null
}

run_dmenu() {
	choice=$(format_list | {
		if command -v voidwolf-dmenu >/dev/null 2>&1; then
			voidwolf-dmenu -i -l 20 -p 'keybinds:'
		else
			dmenu -i -l 20 -p 'keybinds:'
		fi
	}) || true
	# selection is informational only
	[ -n "${choice:-}" ] || true
}

if command -v fzf >/dev/null 2>&1; then
	if command -v voidwolf-float-term >/dev/null 2>&1; then
		# re-exec self in float term with --fzf-only to avoid recursion
		if [ "${1:-}" = "--fzf-only" ]; then
			run_fzf
			exit 0
		fi
		exec voidwolf-float-term keys -- "$0" --fzf-only
	fi
	if command -v st >/dev/null 2>&1; then
		if [ "${1:-}" = "--fzf-only" ]; then
			run_fzf
			exit 0
		fi
		exec st -t "voidwolf-tui:keys" -g "${VOIDWOLF_TUI_GEOM:-100x30}" -e "$0" --fzf-only
	fi
	run_fzf
	exit 0
fi

# no fzf: dmenu searchable list
if command -v dmenu >/dev/null 2>&1 || command -v voidwolf-dmenu >/dev/null 2>&1; then
	run_dmenu
	exit 0
fi

# last resort: plain list in floating st / pager
tmp=$(mktemp) || exit 1
format_list >"$tmp"
if command -v voidwolf-float-term >/dev/null 2>&1; then
	exec voidwolf-float-term keys -- sh -c '${PAGER:-less -R} "$1"; rm -f "$1"; printf "\n[enter]"; read -r _' _ "$tmp"
fi
${PAGER:-less -R} "$tmp"
rm -f "$tmp"
