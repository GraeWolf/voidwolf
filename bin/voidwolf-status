#!/bin/sh
# voidwolf-status — dwm bar feed via xsetroot -name (status2d color codes)
# Inspired by ChadWM bar modules: updates · power · CPU · RAM · net · clock
# Colors from ~/.config/voidwolf/generated/status.env (voidwolf-theme).
#
# status2d: ^c#RRGGBB^ fg  ^b#RRGGBB^ bg  ^d^ reset  ^fN^ advance N px

INTERVAL="${VOIDWOLF_STATUS_INTERVAL:-2}"
UPDATE_EVERY="${VOIDWOLF_STATUS_UPDATE_EVERY:-300}"  # seconds between xbps update checks

# defaults (overridden by status.env)
status_bg="#1e1e2e"
status_fg="#cdd6f4"
status_muted="#6c7086"
status_accent="#89b4fa"
status_urgent="#f38ba8"
status_ok="#a6e3a1"
status_warn="#f9e2af"
status_module_bg="#313244"
status_chip_fg="#11111b"

load_colors() {
	envf="${HOME}/.config/voidwolf/generated/status.env"
	# shellcheck disable=SC1090
	[ -f "$envf" ] && . "$envf"
}

# chip: colored label bg + value bg (ChadWM-like)
chip() {
	# chip <icon_or_label_color> <label> <value>
	lc="$1"; lab="$2"; val="$3"
	printf '^c%s^^b%s^ %s ^c%s^^b%s^ %s ^d^' \
		"$status_chip_fg" "$lc" "$lab" \
		"$status_fg" "$status_module_bg" "$val"
}

icon_val() {
	# icon_val <fg> <icon> <value>
	printf '^c%s^ %s %s ^d^' "$1" "$2" "$3"
}

cpu() {
	load=$(awk '{print $1}' /proc/loadavg 2>/dev/null) || load="?"
	# colored text icon+value (no chip background)
	icon_val "$status_ok" "󰻠" "$load"
}

mem() {
	# used human (free -h style without i)
	used=$(awk '/MemTotal:/{t=$2} /MemAvailable:/{a=$2} END{
		u=(t-a)*1024;
		if (u>=1073741824) printf "%.1fG", u/1073741824;
		else if (u>=1048576) printf "%.0fM", u/1048576;
		else printf "%.0fK", u/1024;
	}' /proc/meminfo 2>/dev/null) || used="?"
	icon_val "$status_urgent" "󰍛" "$used"
}

battery() {
	# AC first
	for a in /sys/class/power_supply/A{C,DP}*; do
		[ -f "$a/online" ] || continue
		on=$(cat "$a/online" 2>/dev/null) || continue
		if [ "$on" = "1" ]; then
			# on AC — show plug if no battery, else fall through with charging
			has_bat=0
			for d in /sys/class/power_supply/BAT*; do
				[ -d "$d" ] && has_bat=1 && break
			done
			if [ "$has_bat" -eq 0 ]; then
				icon_val "$status_ok" "󰚥" "AC"
				return
			fi
		fi
	done
	for d in /sys/class/power_supply/BAT*; do
		[ -d "$d" ] || continue
		cap=$(cat "$d/capacity" 2>/dev/null) || continue
		stat=$(cat "$d/status" 2>/dev/null) || stat="?"
		case "$stat" in
			Charging) icon="󰂄"; col="$status_ok" ;;
			Full) icon="󰁹"; col="$status_ok" ;;
			Discharging)
				if [ "${cap:-0}" -le 15 ] 2>/dev/null; then
					icon="󰂎"; col="$status_urgent"
				elif [ "${cap:-0}" -le 40 ] 2>/dev/null; then
					icon="󰁽"; col="$status_warn"
				else
					icon="󰁾"; col="$status_accent"
				fi
				;;
			*) icon="󰁹"; col="$status_muted" ;;
		esac
		icon_val "$col" "$icon" "${cap}%"
		return
	done
}

network() {
	if command -v nmcli >/dev/null 2>&1; then
		ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
		if [ -n "$ssid" ]; then
			icon_val "$status_accent" "󰤨" "$ssid"
			return
		fi
		if nmcli -t -f DEVICE,TYPE,STATE dev status 2>/dev/null | grep -q ':ethernet:connected'; then
			icon_val "$status_accent" "󰈀" "eth"
			return
		fi
		icon_val "$status_muted" "󰤭" "Disconnected"
		return
	fi
	# sysfs fallback
	for n in /sys/class/net/wl*; do
		[ -f "$n/operstate" ] || continue
		case "$(cat "$n/operstate" 2>/dev/null)" in
			up) icon_val "$status_accent" "󰤨" "wifi"; return ;;
		esac
	done
	for n in /sys/class/net/e*; do
		[ -f "$n/operstate" ] || continue
		case "$(cat "$n/operstate" 2>/dev/null)" in
			up) icon_val "$status_accent" "󰈀" "eth"; return ;;
		esac
	done
	icon_val "$status_muted" "󰤭" "Disconnected"
}

volume() {
	command -v wpctl >/dev/null 2>&1 || return 0
	out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || return 0
	vol=$(printf '%s' "$out" | awk '{print int($2*100)}')
	case "$out" in
		*MUTED*) icon_val "$status_muted" "󰝟" "mute" ;;
		*) icon_val "$status_fg" "󰕾" "${vol}%" ;;
	esac
}

clock() {
	t=$(date '+%H:%M')
	# colored text; drawn in bar *center* by dwm (see \x1f split)
	icon_val "$status_accent" "󰥔" "$t"
}

# package updates (cached; slow on Void)
_updates_cache=""
_updates_ts=0
pkg_updates() {
	now=$(date +%s)
	if [ -n "$_updates_cache" ] && [ $((now - _updates_ts)) -lt "$UPDATE_EVERY" ]; then
		printf '%s' "$_updates_cache"
		return
	fi
	n=""
	if command -v xbps-install >/dev/null 2>&1; then
		# -Mun: manual updates available (no install)
		n=$(timeout 25 xbps-install -Mun 2>/dev/null | wc -l | tr -d ' ')
	fi
	[ -n "$n" ] || n="0"
	if [ "$n" = "0" ]; then
		_updates_cache=$(icon_val "$status_ok" "󰚰" "0")
	else
		_updates_cache=$(icon_val "$status_warn" "󰚰" "$n")
	fi
	_updates_ts=$now
	printf '%s' "$_updates_cache"
}

while true; do
	load_colors
	# Right modules | ASCII unit separator | center clock
	# dwm drawbar: no window title; clock centered; modules right-aligned
	right="$(pkg_updates)$(battery)$(cpu)$(mem)$(network)$(volume)"
	center="$(clock)"
	# shell: \037 = unit separator (dwm splits on 0x1f)
	line=$(printf '%s\037%s' "$right" "$center")
	xsetroot -name "$line" 2>/dev/null || true
	sleep "$INTERVAL"
done
