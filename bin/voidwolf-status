#!/bin/sh
# voidwolf-status — dwm bar feed (status2d + statuscmd)
# Format:  \001 updates … \002 volume \x1f center-clock
# Single instance via lock directory (prevents clock flicker).
# Package check is background-only (never blocks the clock loop).
#
# status2d: ^c#RRGGBB^ fg  ^d^ reset
# statuscmd ids: \001 = updates, \002 = volume

export PATH="${HOME}/.local/bin:${PATH}"

INTERVAL="${VOIDWOLF_STATUS_INTERVAL:-1}"
UPDATE_EVERY="${VOIDWOLF_STATUS_UPDATE_EVERY:-300}"
RT="${XDG_RUNTIME_DIR:-/tmp}"
LOCKDIR="${RT}/voidwolf-status.lockdir"
UPD_CACHE="${RT}/voidwolf-status.updates"
UPD_TS="${RT}/voidwolf-status.updates.ts"
UPD_BUSY="${RT}/voidwolf-status.updates.busy"
WAKE="${RT}/voidwolf-status.wake"

# --- single instance ---
if ! mkdir "$LOCKDIR" 2>/dev/null; then
	exit 0
fi
trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT INT TERM HUP

status_bg="#1e1e2e"
status_fg="#cdd6f4"
status_muted="#6c7086"
status_accent="#89b4fa"
status_urgent="#f38ba8"
status_ok="#a6e3a1"
status_warn="#f9e2af"

load_colors() {
	envf="${HOME}/.config/voidwolf/generated/status.env"
	# shellcheck disable=SC1090
	[ -f "$envf" ] && . "$envf"
}

icon_val() {
	printf '^c%s^ %s %s ^d^' "$1" "$2" "$3"
}

cpu() {
	load=$(awk '{print $1}' /proc/loadavg 2>/dev/null) || load="?"
	icon_val "$status_ok" "󰻠" "$load"
}

mem() {
	used=$(awk '/MemTotal:/{t=$2} /MemAvailable:/{a=$2} END{
		u=(t-a)*1024;
		if (u>=1073741824) printf "%.1fG", u/1073741824;
		else if (u>=1048576) printf "%.0fM", u/1048576;
		else printf "%.0fK", u/1024;
	}' /proc/meminfo 2>/dev/null) || used="?"
	icon_val "$status_urgent" "󰍛" "$used"
}

battery() {
	for a in /sys/class/power_supply/A{C,DP}*; do
		[ -f "$a/online" ] || continue
		on=$(cat "$a/online" 2>/dev/null) || continue
		if [ "$on" = "1" ]; then
			has_bat=0
			for d in /sys/class/power_supply/BAT*; do
				[ -d "$d" ] && has_bat=1 && break
			done
			if [ "$has_bat" -eq 0 ]; then
				icon_val "$status_ok" "󰚥" "AC"
				return
			fi
		fi
	done
	for d in /sys/class/power_supply/BAT*; do
		[ -d "$d" ] || continue
		cap=$(cat "$d/capacity" 2>/dev/null) || continue
		stat=$(cat "$d/status" 2>/dev/null) || stat="?"
		case "$stat" in
			Charging) icon="󰂄"; col="$status_ok" ;;
			Full) icon="󰁹"; col="$status_ok" ;;
			Discharging)
				if [ "${cap:-0}" -le 15 ] 2>/dev/null; then
					icon="󰂎"; col="$status_urgent"
				elif [ "${cap:-0}" -le 40 ] 2>/dev/null; then
					icon="󰁽"; col="$status_warn"
				else
					icon="󰁾"; col="$status_accent"
				fi
				;;
			*) icon="󰁹"; col="$status_muted" ;;
		esac
		icon_val "$col" "$icon" "${cap}%"
		return
	done
}

network() {
	if command -v nmcli >/dev/null 2>&1; then
		ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
		if [ -n "$ssid" ]; then
			icon_val "$status_accent" "󰤨" "$ssid"
			return
		fi
		if nmcli -t -f DEVICE,TYPE,STATE dev status 2>/dev/null | grep -q ':ethernet:connected'; then
			icon_val "$status_accent" "󰈀" "eth"
			return
		fi
	fi
	icon_val "$status_muted" "󰤭" "Disconnected"
}

volume() {
	command -v wpctl >/dev/null 2>&1 || return 0
	out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || return 0
	vol=$(printf '%s\n' "$out" | awk '{
		for (i=1;i<=NF;i++)
			if ($i ~ /^[0-9]+(\.[0-9]+)?$/) {
				printf "%d", ($i+0)*100+0.5; exit
			}
	}')
	[ -n "$vol" ] || vol="?"
	case "$out" in
		*MUTED*) icon_val "$status_muted" "󰝟" "mute" ;;
		*) icon_val "$status_fg" "󰕾" "${vol}%" ;;
	esac
}

clock() {
	# always full date + time with seconds (center)
	t=$(date '+%a %Y-%m-%d %H:%M:%S')
	icon_val "$status_accent" "󰥔" "$t"
}

refresh_updates_bg() {
	# only one background check at a time
	if ! mkdir "$UPD_BUSY" 2>/dev/null; then
		return 0
	fi
	(
		n=0
		if command -v xbps-install >/dev/null 2>&1; then
			n=$(timeout 40 xbps-install -Mun 2>/dev/null | wc -l | tr -d ' ')
			[ -n "$n" ] || n=0
		fi
		printf '%s\n' "$n" >"${UPD_CACHE}.tmp"
		mv -f "${UPD_CACHE}.tmp" "$UPD_CACHE"
		date +%s >"$UPD_TS"
		rmdir "$UPD_BUSY" 2>/dev/null || true
	) >/dev/null 2>&1 &
}

pkg_updates() {
	now=$(date +%s)
	n=0
	[ -f "$UPD_CACHE" ] && n=$(cat "$UPD_CACHE" 2>/dev/null) || n=0
	[ -n "$n" ] || n=0
	ts=0
	[ -f "$UPD_TS" ] && ts=$(cat "$UPD_TS" 2>/dev/null) || ts=0
	if [ $((now - ts)) -ge "$UPDATE_EVERY" ] || [ ! -f "$UPD_CACHE" ]; then
		refresh_updates_bg
	fi
	if [ "$n" = "0" ]; then
		icon_val "$status_ok" "󰚰" "0"
	else
		icon_val "$status_warn" "󰚰" "$n"
	fi
}

# ~INTERVAL seconds of 0.2s slices; wake early on volume scroll
wait_interval() {
	ticks=$((INTERVAL * 5))
	[ "$ticks" -lt 1 ] && ticks=5
	i=0
	while [ "$i" -lt "$ticks" ]; do
		if [ -f "$WAKE" ]; then
			rm -f "$WAKE"
			return 0
		fi
		sleep 0.2
		i=$((i + 1))
	done
}

while true; do
	load_colors
	u=$(pkg_updates)
	b=$(battery)
	c=$(cpu)
	m=$(mem)
	n=$(network)
	v=$(volume)
	# section markers for statuscmd (must be first byte of each section)
	right=$(printf '\001%s%s%s%s%s\002%s' "$u" "$b" "$c" "$m" "$n" "$v")
	center=$(clock)
	line=$(printf '%s\037%s' "$right" "$center")
	xsetroot -name "$line" 2>/dev/null || true
	wait_interval
done
