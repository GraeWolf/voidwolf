#!/bin/sh
# Launch Brave: prefer brave-origin (vw-repo), then brave-origin-bin, then brave.
for b in brave-origin brave-origin-bin brave; do
	if command -v "$b" >/dev/null 2>&1; then
		exec "$b" "$@"
	fi
done
printf '%s\n' "voidwolf-browser: no brave package found (brave-origin / brave-origin-bin)" >&2
exit 1
