#!/bin/sh
# Super+Shift+Return — Brave via vw-repo package names
# Package names and binary names often differ (e.g. brave-origin-bin → brave-origin-nightly).
export PATH="${HOME}/.local/bin:${PATH}"

# Dark GTK for Chromium dialogs / file choosers (Void: prefer Yaru-dark, not Adwaita-dark path)
if [ -f "${HOME}/.config/voidwolf/gtk.env" ]; then
	# shellcheck disable=SC1091
	. "${HOME}/.config/voidwolf/gtk.env"
elif [ -f "${HOME}/.config/voidwolf/generated/gtk.env" ]; then
	# shellcheck disable=SC1091
	. "${HOME}/.config/voidwolf/generated/gtk.env"
else
	export GTK_APPLICATION_PREFER_DARK_THEME=1
	if [ -d /usr/share/themes/Yaru-dark ]; then
		export GTK_THEME="${GTK_THEME:-Yaru-dark}"
	fi
fi

# Prefer explicit binaries (command -v), then known install paths.
for b in \
	brave-origin \
	brave-origin-bin \
	brave-origin-nightly \
	brave-browser \
	brave \
	brave-nightly
do
	if command -v "$b" >/dev/null 2>&1; then
		exec "$b" "$@"
	fi
done

# Fallback: scan common vw-repo / official install prefixes
for path in \
	/opt/brave.com/brave-origin-nightly/brave-origin-nightly \
	/opt/brave.com/brave-origin/brave-origin \
	/opt/brave.com/brave/brave \
	/usr/lib/brave-browser/brave \
	/usr/lib/brave-bin/brave
do
	if [ -x "$path" ]; then
		exec "$path" "$@"
	fi
done

echo "voidwolf-browser: no Brave binary found" >&2
echo "  try: sudo xbps-install -y brave-origin   # or brave-origin-bin" >&2
echo "  binaries often named: brave-origin, brave-origin-nightly, brave" >&2
command -v notify-send >/dev/null 2>&1 && notify-send "voidwolf" "Brave not installed"
exit 1
