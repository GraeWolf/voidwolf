#!/bin/sh
# voidwolf-wallpaper — set / restore wallpaper
# Full picker lands in PR8; restore uses last path or a solid fallback.

cmd="${1:-restore}"
cfg="${HOME}/.config/voidwolf/current/wallpaper"
default_wall=""

# Prefer repo default if VOIDWOLF_ROOT / repo-root known
if [ -f "${HOME}/.config/voidwolf/repo-root" ]; then
	root=$(cat "${HOME}/.config/voidwolf/repo-root")
	if [ -f "${root}/wallpapers/voidwolf-default.jpg" ]; then
		default_wall="${root}/wallpapers/voidwolf-default.jpg"
	fi
fi

set_wall() {
	path="$1"
	[ -n "$path" ] && [ -f "$path" ] || return 1
	if command -v xwallpaper >/dev/null 2>&1; then
		xwallpaper --zoom "$path"
	elif command -v feh >/dev/null 2>&1; then
		feh --bg-fill "$path"
	elif command -v hsetroot >/dev/null 2>&1; then
		hsetroot -cover "$path"
	else
		return 1
	fi
	mkdir -p "$(dirname "$cfg")"
	printf '%s\n' "$path" >"$cfg"
	return 0
}

case "$cmd" in
	restore)
		if [ -f "$cfg" ]; then
			path=$(cat "$cfg")
			set_wall "$path" && exit 0
		fi
		if [ -n "$default_wall" ]; then
			set_wall "$default_wall" && exit 0
		fi
		# solid fallback so session is not blank-ugly
		if command -v hsetroot >/dev/null 2>&1; then
			hsetroot -solid "#1d2021"
		elif command -v xsetroot >/dev/null 2>&1; then
			xsetroot -solid "#1d2021"
		fi
		exit 0
		;;
	set)
		path="${2:-}"
		[ -n "$path" ] || { echo "Usage: voidwolf-wallpaper set <path>" >&2; exit 2; }
		set_wall "$path" || { echo "voidwolf-wallpaper: failed to set $path" >&2; exit 1; }
		;;
	pick)
		# Prefer choosing an image then extracting a theme (PR9b)
		dir="${VOIDWOLF_WALLPAPER_DIR:-$HOME/Pictures}"
		if [ ! -d "$dir" ]; then
			dir="${HOME}"
		fi
		if command -v voidwolf-dmenu >/dev/null 2>&1 || command -v dmenu >/dev/null 2>&1; then
			# list common image files (depth 2)
			list=$(find "$dir" -maxdepth 2 -type f \( \
				-iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \
				\) 2>/dev/null | head -200)
			# always offer repo default
			if [ -f "${HOME}/.config/voidwolf/repo-root" ]; then
				root=$(cat "${HOME}/.config/voidwolf/repo-root")
				[ -f "${root}/wallpapers/voidwolf-default.png" ] \
					&& list="${root}/wallpapers/voidwolf-default.png
${list}"
			fi
			if [ -z "$list" ]; then
				echo "voidwolf-wallpaper: no images under $dir" >&2
				exit 1
			fi
			if command -v voidwolf-dmenu >/dev/null 2>&1; then
				choice=$(printf '%s\n' "$list" | voidwolf-dmenu -i -l 12 -p "wallpaper:")
			else
				choice=$(printf '%s\n' "$list" | dmenu -i -l 12 -p "wallpaper:")
			fi
			[ -n "$choice" ] || exit 0
			if command -v voidwolf-theme >/dev/null 2>&1; then
				exec voidwolf-theme from-wallpaper "$choice"
			fi
			exec voidwolf-wallpaper set "$choice"
		fi
		echo "voidwolf-wallpaper pick: need dmenu; or: voidwolf-theme from-wallpaper <path>" >&2
		exit 1
		;;
	from-wallpaper|extract)
		# alias
		shift
		exec voidwolf-theme from-wallpaper "$@"
		;;
	*)
		echo "Usage: voidwolf-wallpaper <restore|set|pick|from-wallpaper> [path]" >&2
		exit 2
		;;
esac
