#!/bin/sh
# File manager launcher. Prefer Nemo (GUI), then other FMs / TUI.
export PATH="${HOME}/.local/bin:${PATH}"

if command -v nemo >/dev/null 2>&1; then
	exec nemo "$@"
fi
if command -v thunar >/dev/null 2>&1; then
	exec thunar "$@"
fi
if command -v pcmanfm >/dev/null 2>&1; then
	exec pcmanfm "$@"
fi
if command -v lf >/dev/null 2>&1; then
	if command -v voidwolf-float-term >/dev/null 2>&1; then
		exec voidwolf-float-term files -- lf "$@"
	fi
	exec st -e lf "$@"
fi
if command -v ranger >/dev/null 2>&1; then
	if command -v voidwolf-float-term >/dev/null 2>&1; then
		exec voidwolf-float-term files -- ranger "$@"
	fi
	exec st -e ranger "$@"
fi
# fallback: open home in st
exec st -e sh -c 'cd; exec "$SHELL"'
