#!/usr/bin/env python3
"""voidwolf-theme — color theme engine (PR8 + PR9a adapters).

Exit codes: 0 ok, 1 usage, 2 not found, 3 adapter failure, 4 schema invalid.

Adapters: dwm colors.h, st Xresources, dmenu.env, dunst, GTK3/4 (PR9a).
"""
from __future__ import annotations

import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

try:
    import tomllib
except ImportError:  # pragma: no cover
    print("voidwolf-theme: Python 3.11+ with tomllib required", file=sys.stderr)
    sys.exit(1)

HEX_RE = re.compile(r"^#[0-9A-Fa-f]{6}$")
REQUIRED_PALETTE = ("bg", "fg", "accent", "urgent")
ANSI = tuple(f"color{i}" for i in range(16))

# --- paths -----------------------------------------------------------------

def repo_root() -> Path:
    env = os.environ.get("VOIDWOLF_ROOT")
    if env:
        return Path(env).expanduser().resolve()
    home_marker = Path.home() / ".config/voidwolf/repo-root"
    if home_marker.is_file():
        return Path(home_marker.read_text().strip()).resolve()
    # bin/voidwolf-theme → repo root
    return Path(__file__).resolve().parent.parent


def voidwolf_home() -> Path:
    return Path(os.environ.get("VOIDWOLF_HOME", Path.home() / ".config/voidwolf")).expanduser()


def theme_search_dirs() -> list[Path]:
    dirs = [
        voidwolf_home() / "themes",
        repo_root() / "themes",
        Path("/usr/share/voidwolf/themes"),
    ]
    return [d for d in dirs if d.is_dir()]


def atomic_write(path: Path, data: str | bytes, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if isinstance(data, str):
        payload = data.encode()
    else:
        payload = data
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".tmp-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(payload)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# --- load / validate -------------------------------------------------------

def load_toml(path: Path) -> dict:
    with path.open("rb") as f:
        return tomllib.load(f)


def validate_theme(data: dict, path: Path | None = None, strict_ansi: bool = True) -> list[str]:
    errs: list[str] = []
    if data.get("schema_version") != 1:
        errs.append("schema_version must be 1")
    if not data.get("name"):
        errs.append("name is required")
    pal = data.get("palette") or {}
    if not isinstance(pal, dict):
        errs.append("palette must be a table")
        return errs
    for key in REQUIRED_PALETTE:
        if key not in pal:
            errs.append(f"palette.{key} is required")
        elif not isinstance(pal[key], str) or not HEX_RE.match(pal[key]):
            errs.append(f"palette.{key} must be #RRGGBB")
    for key, val in pal.items():
        if isinstance(val, str) and val.startswith("#") and not HEX_RE.match(val):
            errs.append(f"palette.{key} invalid hex: {val}")
    if strict_ansi:
        for c in ANSI:
            if c not in pal:
                errs.append(f"palette.{c} is required for shipped themes")
            elif not HEX_RE.match(str(pal.get(c, ""))):
                errs.append(f"palette.{c} must be #RRGGBB")
    return errs


def normalize(data: dict) -> dict:
    """Fill defaults for optional palette fields."""
    pal = dict(data.get("palette") or {})
    bg, fg, accent = pal["bg"], pal["fg"], pal["accent"]
    pal.setdefault("cursor", fg)
    pal.setdefault("border_normal", _blend(bg, "#000000", 0.3))
    pal.setdefault("border_focused", accent)
    pal.setdefault("bar_bg", bg)
    pal.setdefault("bar_fg", fg)
    pal.setdefault("bar_selected_bg", accent)
    pal.setdefault("bar_selected_fg", bg)
    data = dict(data)
    data["palette"] = pal
    meta = dict(data.get("meta") or {})
    data["meta"] = meta
    opts = dict(data.get("options") or {})
    data["options"] = opts
    return data


def _blend(a: str, b: str, t: float) -> str:
    def h(x: str) -> tuple[int, int, int]:
        x = x.lstrip("#")
        return int(x[0:2], 16), int(x[2:4], 16), int(x[4:6], 16)

    ar, ag, ab = h(a)
    br, bg, bb = h(b)
    r = int(ar * (1 - t) + br * t)
    g = int(ag * (1 - t) + bg * t)
    b_ = int(ab * (1 - t) + bb * t)
    return f"#{r:02x}{g:02x}{b_:02x}"


def find_theme(name: str) -> Path | None:
    for d in theme_search_dirs():
        p = d / f"{name}.toml"
        if p.is_file():
            return p
    return None


def list_themes() -> list[tuple[str, str, Path]]:
    seen: set[str] = set()
    out: list[tuple[str, str, Path]] = []
    for d in theme_search_dirs():
        for p in sorted(d.glob("*.toml")):
            try:
                data = load_toml(p)
            except Exception:
                continue
            name = str(data.get("name") or p.stem)
            if name in seen:
                continue
            seen.add(name)
            disp = str(data.get("display_name") or name)
            out.append((name, disp, p))
    return out


def resolve_wallpaper(rel: str | None) -> Path | None:
    if not rel:
        return None
    path = Path(rel)
    if path.is_absolute() and path.is_file():
        return path
    candidates = [
        repo_root() / rel,
        Path("/usr/share/voidwolf") / rel,
        voidwolf_home() / rel,
    ]
    for c in candidates:
        if c.is_file():
            return c
    return None


# --- adapters --------------------------------------------------------------

def gen_colors_h(pal: dict) -> str:
    return f"""/* colors.h — GENERATED by voidwolf-theme; do not hand-edit */
static const char col_gray1[]       = "{pal['bar_bg']}"; /* bg / bar bg */
static const char col_gray2[]       = "{pal['border_normal']}"; /* border unfocused */
static const char col_gray3[]       = "{pal['bar_fg']}"; /* fg */
static const char col_gray4[]       = "{pal['bar_selected_fg']}"; /* sel fg */
static const char col_cyan[]        = "{pal['bar_selected_bg']}"; /* accent / sel */
static const char col_urgborder[]   = "{pal['urgent']}";

static const char *colors[][3] = {{
	/*               fg         bg         border   */
	[SchemeNorm] = {{ col_gray3, col_gray1, col_gray2 }},
	[SchemeSel]  = {{ col_gray4, col_cyan,  col_cyan  }},
}};
"""


def gen_xresources(pal: dict) -> str:
    lines = [
        "! voidwolf generated theme.Xresources — do not hand-edit",
        f"*.foreground: {pal['fg']}",
        f"*.background: {pal['bg']}",
        f"*.cursorColor: {pal.get('cursor', pal['fg'])}",
        f"st.foreground: {pal['fg']}",
        f"st.background: {pal['bg']}",
        f"st.cursorColor: {pal.get('cursor', pal['fg'])}",
    ]
    for i in range(16):
        c = pal.get(f"color{i}", pal["fg"] if i == 7 else pal["bg"])
        lines.append(f"*.color{i}: {c}")
        lines.append(f"st.color{i}: {c}")
    return "\n".join(lines) + "\n"


def gen_dmenu_env(pal: dict) -> str:
    return (
        f"# generated by voidwolf-theme — sourced by voidwolf-dmenu / launcher\n"
        f"export VOIDWOLF_DMENU_NB='{pal['bg']}'\n"
        f"export VOIDWOLF_DMENU_NF='{pal['fg']}'\n"
        f"export VOIDWOLF_DMENU_SB='{pal['accent']}'\n"
        f"export VOIDWOLF_DMENU_SF='{pal['bar_selected_fg']}'\n"
        f"export VOIDWOLF_DMENU_FN='${{VOIDWOLF_DMENU_FN:-Fira Code:size=11}}'\n"
    )


def gen_dunstrc_colors(pal: dict) -> str:
    return f"""# voidwolf-generated dunst colors — do not hand-edit
# included from ~/.config/dunst/dunstrc

[global]
    frame_color = "{pal['accent']}"
    separator_color = "{pal['border_normal']}"

[urgency_low]
    background = "{pal['bg']}"
    foreground = "{pal['fg']}"
    frame_color = "{pal['border_normal']}"
    timeout = 5

[urgency_normal]
    background = "{pal['bg']}"
    foreground = "{pal['fg']}"
    frame_color = "{pal['accent']}"
    timeout = 10

[urgency_critical]
    background = "{pal['bg']}"
    foreground = "{pal['urgent']}"
    frame_color = "{pal['urgent']}"
    timeout = 0
"""


def _prefer_dark(gtk_theme: str, *, force_dark: bool = True) -> str:
    """voidwolf presets are dark; always prefer dark unless meta says light."""
    if not force_dark:
        t = gtk_theme.lower()
        if "dark" in t or "mocha" in t or "night" in t or "pine" in t:
            return "1"
        return "0"
    return "1"


def _theme_dir_exists(name: str) -> bool:
    if not name or name in (".", ".."):
        return False
    for base in (Path("/usr/share/themes"), Path.home() / ".themes"):
        if (base / name).is_dir():
            return True
    # GTK3/4 often ship Adwaita as a built-in name without a themes/ dir
    if name in ("Adwaita", "Adwaita-dark", "HighContrast", "HighContrastInverse"):
        return True
    return False


def _icon_dir_exists(name: str) -> bool:
    if not name:
        return False
    for base in (Path("/usr/share/icons"), Path.home() / ".icons"):
        if (base / name).is_dir():
            return True
    return False


def resolve_gtk_theme(preferred: str | None) -> str:
    """Pick a GTK theme that exists on this host.

    Void does not ship a standalone Adwaita *theme package* under
    /usr/share/themes (Adwaita is built into GTK). Prefer Yaru-dark (yaru
    package) when present, then other *dark* themes, then Adwaita fallbacks.
    """
    candidates: list[str] = []
    if preferred:
        candidates.append(preferred)
    # Void-friendly dark themes (order matters)
    candidates.extend(
        [
            "Yaru-dark",
            "Yaru-purple-dark",
            "Yaru-blue-dark",
            "Yaru-olive-dark",
            "Adwaita-dark",
            "Adwaita",
            "Breeze-Dark",
            "Breeze",
        ]
    )
    seen: set[str] = set()
    for name in candidates:
        if name in seen:
            continue
        seen.add(name)
        if _theme_dir_exists(name):
            return name
    # Last resort: still write a dark-ish name; CSS + prefer-dark carry weight
    return preferred or "Adwaita-dark"


def resolve_icon_theme(preferred: str | None) -> str:
    candidates = []
    if preferred:
        candidates.append(preferred)
    candidates.extend(["Adwaita", "Yaru", "Yaru-dark", "hicolor", "breeze-dark", "breeze"])
    seen: set[str] = set()
    for name in candidates:
        if name in seen:
            continue
        seen.add(name)
        if _icon_dir_exists(name):
            return name
    return preferred or "hicolor"


def resolve_cursor_theme(preferred: str | None) -> str:
    # Cursors often live under icons/
    return resolve_icon_theme(preferred or "Adwaita")


def gen_gtk_settings(meta: dict, pal: dict) -> str:
    preferred = str(meta.get("gtk_theme") or "Yaru-dark")
    gtk_theme = resolve_gtk_theme(preferred)
    icon = resolve_icon_theme(str(meta.get("icon_theme") or "Adwaita"))
    cursor = resolve_cursor_theme(str(meta.get("cursor_theme") or "Adwaita"))
    size = int(meta.get("cursor_size") or 24)
    prefer = _prefer_dark(gtk_theme, force_dark=True)
    note = ""
    if preferred and preferred != gtk_theme:
        note = f"# note: requested gtk_theme={preferred!r} not found; using {gtk_theme!r}\n"
    return (
        "# voidwolf-generated — do not hand-edit while using voidwolf-theme\n"
        f"{note}"
        "[Settings]\n"
        f"gtk-theme-name={gtk_theme}\n"
        f"gtk-icon-theme-name={icon}\n"
        f"gtk-cursor-theme-name={cursor}\n"
        f"gtk-cursor-theme-size={size}\n"
        f"gtk-application-prefer-dark-theme={prefer}\n"
        "gtk-font-name=Fira Code 11\n"
        # Helps some portals / libadwaita stacks when gsettings is absent
        "gtk-decoration-layout=menu:minimize,maximize,close\n"
    )


def gen_gtk_css(pal: dict, *, gtk4: bool = False) -> str:
    """Best-effort palette push for GTK3/4 + libadwaita named colors."""
    bg, fg = pal["bg"], pal["fg"]
    accent, urg = pal["accent"], pal["urgent"]
    sel_fg = pal["bar_selected_fg"]
    border = pal.get("border_normal") or pal.get("color8") or bg
    if gtk4:
        return f"""/* voidwolf-generated gtk-4.0 — palette + libadwaita named colors */
@define-color accent_bg_color {accent};
@define-color accent_fg_color {sel_fg};
@define-color accent_color {accent};
@define-color window_bg_color {bg};
@define-color window_fg_color {fg};
@define-color view_bg_color {bg};
@define-color view_fg_color {fg};
@define-color headerbar_bg_color {bg};
@define-color headerbar_fg_color {fg};
@define-color headerbar_backdrop_color {bg};
@define-color headerbar_border_color {border};
@define-color sidebar_bg_color {bg};
@define-color sidebar_fg_color {fg};
@define-color card_bg_color {bg};
@define-color card_fg_color {fg};
@define-color dialog_bg_color {bg};
@define-color dialog_fg_color {fg};
@define-color popover_bg_color {bg};
@define-color popover_fg_color {fg};
@define-color destructive_bg_color {urg};
@define-color destructive_fg_color {sel_fg};
@define-color error_color {urg};
@define-color success_color {pal.get('color2', accent)};
@define-color warning_color {pal.get('color3', accent)};

/* Nudge common widgets when the base theme is light fallback */
window, dialog, messagedialog, .background {{
  background-color: {bg};
  color: {fg};
}}
"""
    return f"""/* voidwolf-generated gtk-3.0 — palette push */
@define-color accent_bg_color {accent};
@define-color accent_fg_color {sel_fg};
@define-color theme_bg_color {bg};
@define-color theme_fg_color {fg};
@define-color theme_base_color {bg};
@define-color theme_text_color {fg};
@define-color theme_selected_bg_color {accent};
@define-color theme_selected_fg_color {sel_fg};
@define-color theme_unfocused_bg_color {bg};
@define-color theme_unfocused_fg_color {fg};
@define-color borders {border};
@define-color error_color {urg};

window, dialog, messagedialog, .background, .titlebar, headerbar {{
  background-color: {bg};
  color: {fg};
}}
"""


def apply_gsettings_gtk(meta: dict, settings_ini: str) -> None:
    """Sync GNOME/libadwaita color-scheme when gsettings is available."""
    if not shutil.which("gsettings"):
        return
    # Parse chosen theme name from generated ini
    gtk_theme = "Yaru-dark"
    icon = "Adwaita"
    for line in settings_ini.splitlines():
        if line.startswith("gtk-theme-name="):
            gtk_theme = line.split("=", 1)[1].strip()
        elif line.startswith("gtk-icon-theme-name="):
            icon = line.split("=", 1)[1].strip()
    env = {**os.environ}
    # Quiet failures if schemas missing (minimal Void install)
    cmds = [
        ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_theme],
        ["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icon],
        ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark"],
        ["gsettings", "set", "org.gnome.desktop.interface", "gtk-application-prefer-dark-theme", "true"],
    ]
    cursor = str(meta.get("cursor_theme") or "")
    if cursor:
        cmds.append(
            ["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", resolve_cursor_theme(cursor)]
        )
    for cmd in cmds:
        subprocess.run(cmd, check=False, capture_output=True, env=env)


def _skip_user_config() -> bool:
    return os.environ.get("VOIDWOLF_THEME_SKIP_USER_CONFIG", "").lower() in (
        "1",
        "true",
        "yes",
    )


def install_user_file(dest: Path, content: str, mode: int = 0o644) -> None:
    """Write to user config path unless SKIP_USER_CONFIG."""
    if _skip_user_config():
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(dest, content, mode)


def ensure_dunst_main_config() -> None:
    """Install voidwolf dunstrc template if missing or outdated marker."""
    if _skip_user_config():
        return
    dest = Path.home() / ".config/dunst/dunstrc"
    template = repo_root() / "config/dunst/dunstrc"
    if not template.is_file():
        return
    if dest.is_file() and "voidwolf-dunst-v1" in dest.read_text(errors="ignore"):
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.is_file():
        bak = dest.with_suffix(dest.suffix + f".voidwolf-bak")
        try:
            shutil.copy2(dest, bak)
        except OSError:
            pass
    shutil.copy2(template, dest)
    print(f"==> installed dunst config → {dest}")


def reload_dunst() -> None:
    if _skip_user_config() or not os.environ.get("DISPLAY"):
        return
    if shutil.which("dunstctl"):
        subprocess.run(["dunstctl", "reload"], check=False, capture_output=True)
    else:
        subprocess.run(["pkill", "-HUP", "dunst"], check=False)


def gen_palette_toml(data: dict) -> str:
    # minimal dump for state
    pal = data["palette"]
    lines = ["# generated palette snapshot", f'name = "{data["name"]}"', "[palette]"]
    for k, v in pal.items():
        lines.append(f'{k} = "{v}"')
    return "\n".join(lines) + "\n"


def apply_adapters(data: dict, *, rebuild_dwm: bool = True) -> None:
    data = normalize(data)
    pal = data["palette"]
    home = voidwolf_home()
    gen = home / "generated"
    cur = home / "current"
    gen.mkdir(parents=True, exist_ok=True)
    cur.mkdir(parents=True, exist_ok=True)

    # Tests / CI: VOIDWOLF_THEME_SKIP_REBUILD=1 writes adapters only
    if os.environ.get("VOIDWOLF_THEME_SKIP_REBUILD", "").lower() in ("1", "true", "yes"):
        rebuild_dwm = False

    meta = data.get("meta") or {}

    # generated files (PR8 + PR9a)
    colors_h = gen_colors_h(pal)
    xres = gen_xresources(pal)
    dmenu_env = gen_dmenu_env(pal)
    dunst_colors = gen_dunstrc_colors(pal)
    gtk3_ini = gen_gtk_settings(meta, pal)
    gtk4_ini = gen_gtk_settings(meta, pal)
    gtk3_css = gen_gtk_css(pal, gtk4=False)
    gtk4_css = gen_gtk_css(pal, gtk4=True)

    atomic_write(gen / "colors.h", colors_h)
    atomic_write(gen / "theme.Xresources", xres)
    atomic_write(gen / "dmenu.env", dmenu_env)
    atomic_write(gen / "dunstrc.colors", dunst_colors)
    atomic_write(gen / "gtk-3.0.settings.ini", gtk3_ini)
    atomic_write(gen / "gtk-3.0.css", gtk3_css)
    atomic_write(gen / "gtk-4.0.settings.ini", gtk4_ini)
    atomic_write(gen / "gtk-4.0.css", gtk4_css)
    atomic_write(gen / "palette.toml", gen_palette_toml(data))

    # state
    atomic_write(cur / "name", data["name"] + "\n")
    atomic_write(cur / "palette.toml", gen_palette_toml(data))

    # --- PR9a: install user-facing configs ---
    ensure_dunst_main_config()
    # dunst include path uses ~/.config/voidwolf/generated/dunstrc.colors
    # also drop a copy under dunstrc.d for dunst builds that prefer conf.d
    install_user_file(
        Path.home() / ".config/dunst/dunstrc.d/10-voidwolf-theme.conf",
        dunst_colors,
    )
    install_user_file(Path.home() / ".config/gtk-3.0/settings.ini", gtk3_ini)
    install_user_file(Path.home() / ".config/gtk-3.0/gtk.css", gtk3_css)
    install_user_file(Path.home() / ".config/gtk-4.0/settings.ini", gtk4_ini)
    install_user_file(Path.home() / ".config/gtk-4.0/gtk.css", gtk4_css)
    # libadwaita / GNOME color-scheme (prefer-dark) when schemas exist
    if not _skip_user_config():
        apply_gsettings_gtk(meta, gtk3_ini)
        # Export for sessions that read this (.xinitrc + voidwolf-browser)
        theme_line = next(
            (ln for ln in gtk3_ini.splitlines() if ln.startswith("gtk-theme-name=")),
            "gtk-theme-name=Yaru-dark",
        )
        tname = theme_line.split("=", 1)[1].strip()
        gtk_env_body = (
            "# generated by voidwolf-theme — source for GTK/Brave dark chrome\n"
            f"export GTK_THEME='{tname}'\n"
            "export GTK_APPLICATION_PREFER_DARK_THEME=1\n"
        )
        atomic_write(gen / "gtk.env", gtk_env_body)
        install_user_file(Path.home() / ".config/voidwolf/gtk.env", gtk_env_body)

    # Xcursor env helper for startx sessions
    xcursor = (
        f"# generated by voidwolf-theme\n"
        f"export XCURSOR_THEME='{meta.get('cursor_theme') or 'Adwaita'}'\n"
        f"export XCURSOR_SIZE='{int(meta.get('cursor_size') or 24)}'\n"
    )
    atomic_write(gen / "xcursor.env", xcursor)
    # optional source from .xinitrc if present — document only; install snippet
    install_user_file(Path.home() / ".config/voidwolf/xcursor.env", xcursor)

    # dwm colors.h in source tree + rebuild if needed
    dwm_colors = repo_root() / "suckless" / "dwm" / "colors.h"
    content_hash = hashlib.sha256(colors_h.encode()).hexdigest()
    hash_file = gen / "colors.hash"
    old_hash = hash_file.read_text().strip() if hash_file.is_file() else ""
    need_build = content_hash != old_hash

    try:
        atomic_write(dwm_colors, colors_h)
    except OSError as e:
        print(f"voidwolf-theme: cannot write {dwm_colors}: {e}", file=sys.stderr)
        sys.exit(3)

    if rebuild_dwm and need_build:
        build_script = repo_root() / "bootstrap" / "build-suckless.sh"
        dwm_dir = repo_root() / "suckless" / "dwm"
        if build_script.is_file():
            print("==> rebuilding dwm (colors.h changed, PREFIX=$HOME/.local, no sudo)")
            # Force recompile even if an old Makefile missed colors.h deps
            for stale in ("dwm.o", "dwm"):
                try:
                    (dwm_dir / stale).unlink(missing_ok=True)
                except OSError:
                    pass
            r = subprocess.run(
                [str(build_script), "--dwm-only", "--no-clean"],
                env={**os.environ, "PREFIX": str(Path.home() / ".local")},
            )
            if r.returncode != 0:
                print("voidwolf-theme: dwm rebuild failed", file=sys.stderr)
                sys.exit(3)
        atomic_write(hash_file, content_hash + "\n")
        # re-exec dwm if running (restartsig: SIGHUP → exec new binary)
        if os.environ.get("DISPLAY"):
            subprocess.run(["pkill", "-HUP", "-x", "dwm"], check=False)
            print("==> dwm re-exec (SIGHUP) for new bar/border colors")
    else:
        if not need_build:
            print("==> colors.h unchanged (skip rebuild)")
        elif not rebuild_dwm:
            print("==> skip dwm rebuild (VOIDWOLF_THEME_SKIP_REBUILD or rebuild_dwm=False)")
        atomic_write(hash_file, content_hash + "\n")

    # xrdb (st reads at startup — existing st windows keep old colors)
    if os.environ.get("DISPLAY"):
        xres_path = gen / "theme.Xresources"
        base = Path.home() / ".Xresources"
        if base.is_file():
            subprocess.run(["xrdb", "-merge", str(base)], check=False)
        subprocess.run(["xrdb", "-merge", str(xres_path)], check=False)
        print("==> xrdb merged (open a new st for terminal colors)")

    # wallpaper
    wall_rel = (data.get("meta") or {}).get("wallpaper")
    wall = resolve_wallpaper(wall_rel) if wall_rel else None
    if wall:
        atomic_write(cur / "wallpaper", str(wall) + "\n")
        wp = shutil.which("voidwolf-wallpaper")
        if wp and os.environ.get("DISPLAY"):
            subprocess.run([wp, "set", str(wall)], check=False)
        elif os.environ.get("DISPLAY"):
            if shutil.which("xwallpaper"):
                subprocess.run(["xwallpaper", "--zoom", str(wall)], check=False)
            elif shutil.which("feh"):
                subprocess.run(["feh", "--bg-fill", str(wall)], check=False)

    # live reload notifications
    reload_dunst()
    print(f"==> theme applied: {data['name']} (dwm/st/dmenu/dunst/gtk)")


# --- commands --------------------------------------------------------------

def cmd_list(_: list[str]) -> int:
    for name, disp, path in list_themes():
        print(f"{name:24} {disp:24} ({path})")
    return 0


def cmd_current(_: list[str]) -> int:
    name_f = voidwolf_home() / "current" / "name"
    if not name_f.is_file():
        print("(none)")
        return 0
    print(name_f.read_text().strip())
    return 0


def cmd_show(args: list[str]) -> int:
    name = args[0] if args else None
    if not name:
        nf = voidwolf_home() / "current" / "name"
        if nf.is_file():
            name = nf.read_text().strip()
        else:
            print("voidwolf-theme: no current theme; pass a name", file=sys.stderr)
            return 1
    path = find_theme(name)
    if not path:
        print(f"voidwolf-theme: theme not found: {name}", file=sys.stderr)
        return 2
    print(path.read_text())
    return 0


def cmd_validate(args: list[str]) -> int:
    if not args:
        # validate all shipped
        rc = 0
        for name, _, path in list_themes():
            data = load_toml(path)
            errs = validate_theme(data, path)
            if errs:
                rc = 4
                print(f"FAIL {path}")
                for e in errs:
                    print(f"  - {e}")
            else:
                print(f"OK   {name} ({path})")
        return rc
    path = Path(args[0])
    if not path.is_file():
        # try as theme name
        p2 = find_theme(args[0])
        if not p2:
            print(f"voidwolf-theme: not found: {args[0]}", file=sys.stderr)
            return 2
        path = p2
    data = load_toml(path)
    errs = validate_theme(data, path)
    if errs:
        for e in errs:
            print(f"error: {e}", file=sys.stderr)
        return 4
    print(f"OK {path}")
    return 0


def cmd_set(args: list[str]) -> int:
    if not args:
        print("Usage: voidwolf-theme set <name>", file=sys.stderr)
        return 1
    name = args[0]
    path = find_theme(name)
    if not path:
        print(f"voidwolf-theme: theme not found: {name}", file=sys.stderr)
        return 2
    data = load_toml(path)
    errs = validate_theme(data, path)
    if errs:
        for e in errs:
            print(f"error: {e}", file=sys.stderr)
        return 4
    apply_adapters(data)
    return 0


def cmd_pick(_: list[str]) -> int:
    themes = list_themes()
    if not themes:
        print("voidwolf-theme: no themes found", file=sys.stderr)
        return 2
    lines = "\n".join(f"{n}\t{d}" for n, d, _ in themes)
    dmenu = shutil.which("voidwolf-dmenu") or shutil.which("dmenu")
    if not dmenu or not os.environ.get("DISPLAY"):
        # fallback: print list and use first or stdin
        print("Available themes (no dmenu/DISPLAY):")
        for n, d, _ in themes:
            print(f"  {n} — {d}")
        print("Use: voidwolf-theme set <name>")
        return 1
    proc = subprocess.run(
        [dmenu, "-i", "-p", "theme:", "-l", "10"],
        input=lines,
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        return 0
    choice = proc.stdout.strip().split("\t", 1)[0].strip()
    return cmd_set([choice])


def cmd_build_suckless(_: list[str]) -> int:
    """Force regenerate colors from current theme and rebuild dwm."""
    name_f = voidwolf_home() / "current" / "name"
    if name_f.is_file():
        return cmd_set([name_f.read_text().strip()])
    # default
    return cmd_set(["voidwolf-dark"])


def cmd_reload(_: list[str]) -> int:
    return cmd_build_suckless([])


# --- PR9b: wallpaper extraction ---------------------------------------------

def _hex_rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def _rgb_hex(r: int, g: int, b: int) -> str:
    return f"#{max(0, min(255, r)):02x}{max(0, min(255, g)):02x}{max(0, min(255, b)):02x}"


def _lighten(h: str, t: float = 0.25) -> str:
    r, g, b = _hex_rgb(h)
    return _rgb_hex(
        int(r + (255 - r) * t),
        int(g + (255 - g) * t),
        int(b + (255 - b) * t),
    )


def _darken(h: str, t: float = 0.25) -> str:
    r, g, b = _hex_rgb(h)
    return _rgb_hex(int(r * (1 - t)), int(g * (1 - t)), int(b * (1 - t)))


def _luma(h: str) -> float:
    r, g, b = _hex_rgb(h)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _norm_hex(c: str | None) -> str | None:
    if not c:
        return None
    c = str(c).strip()
    if c.startswith("rgb"):
        # rgb(1,2,3) or similar
        m = re.search(r"(\d+)\D+(\d+)\D+(\d+)", c)
        if m:
            return _rgb_hex(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    if not c.startswith("#"):
        c = "#" + c
    if re.match(r"^#[0-9A-Fa-f]{6}$", c):
        return c.lower()
    if re.match(r"^#[0-9A-Fa-f]{3}$", c):
        return ("#" + "".join(ch * 2 for ch in c[1:])).lower()
    return None


def ensure_full_palette(raw: dict[str, str]) -> dict[str, str]:
    """Fill design-required palette fields from partial extraction."""
    pal: dict[str, str] = {}
    for k, v in raw.items():
        hx = _norm_hex(v)
        if hx:
            pal[k] = hx

    # ANSI 0-15
    for i in range(16):
        key = f"color{i}"
        if key not in pal:
            if i >= 8 and f"color{i - 8}" in pal:
                pal[key] = _lighten(pal[f"color{i - 8}"], 0.35)
            elif i < 8 and f"color{i + 8}" in pal:
                pal[key] = _darken(pal[f"color{i + 8}"], 0.25)
            else:
                pal[key] = "#808080"

    # bg/fg from specials or color0/7
    if "bg" not in pal:
        pal["bg"] = pal.get("background") or pal["color0"]
    if "fg" not in pal:
        pal["fg"] = pal.get("foreground") or pal["color7"]
    pal.setdefault("cursor", pal.get("cursorColor") or pal["fg"])

    # pick accent: prefer color4/5 with mid-high chroma vs bg
    if "accent" not in pal:
        candidates = [pal[f"color{i}"] for i in (4, 5, 6, 1, 3, 2, 12, 13)]
        accent = max(candidates, key=lambda h: abs(_luma(h) - _luma(pal["bg"])))
        pal["accent"] = accent
    if "urgent" not in pal:
        pal["urgent"] = pal.get("color1") or "#f07178"

    pal.setdefault("border_normal", _darken(pal["bg"], 0.15) if _luma(pal["bg"]) > 40 else _lighten(pal["bg"], 0.2))
    pal.setdefault("border_focused", pal["accent"])
    pal.setdefault("bar_bg", pal["bg"])
    pal.setdefault("bar_fg", pal["fg"])
    pal.setdefault("bar_selected_bg", pal["accent"])
    pal.setdefault("bar_selected_fg", pal["bg"] if _luma(pal["accent"]) > 128 else pal["fg"])

    # keep only design keys + color0-15
    keys = [
        "bg", "fg", "cursor", "accent", "urgent",
        "border_normal", "border_focused",
        "bar_bg", "bar_fg", "bar_selected_bg", "bar_selected_fg",
        *ANSI,
    ]
    return {k: pal[k] for k in keys}


def slugify_name(stem: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", stem.lower()).strip("-")
    return (s or "wall")[:48]


def dump_theme_toml(data: dict) -> str:
    """Serialize theme dict to TOML (minimal, no external lib)."""
    lines = [
        f"schema_version = {int(data.get('schema_version', 1))}",
        f'name = "{data["name"]}"',
        f'display_name = "{data.get("display_name", data["name"])}"',
        f'author = "{data.get("author", "voidwolf-derived")}"',
        f'description = "{data.get("description", "").replace(chr(34), "")}"',
        "",
        "[palette]",
    ]
    for k, v in (data.get("palette") or {}).items():
        lines.append(f'{k} = "{v}"')
    meta = data.get("meta") or {}
    lines.append("")
    lines.append("[meta]")
    for k, v in meta.items():
        if isinstance(v, int):
            lines.append(f"{k} = {v}")
        else:
            lines.append(f'{k} = "{v}"')
    lines.append("")
    lines.append("[options]")
    lines.append("dwm_border_px = 2")
    lines.append("dwm_showbar = true")
    return "\n".join(lines) + "\n"


def _read_json(path: Path) -> dict | None:
    if not path.is_file():
        return None
    try:
        import json

        return json.loads(path.read_text())
    except Exception:
        return None


def extract_wallust(image: Path) -> tuple[dict[str, str], str] | None:
    if not shutil.which("wallust"):
        return None
    # Prefer colorscheme-only if available; fall back to run
    for cmd in (
        ["wallust", "cs", str(image)],
        ["wallust", "run", str(image), "-q"],
        ["wallust", "run", str(image)],
    ):
        try:
            subprocess.run(cmd, check=True, capture_output=True, timeout=120)
            break
        except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired):
            continue
    else:
        return None

    cache = Path.home() / ".cache" / "wallust"
    candidates = [
        cache / "colors.json",
        cache / "colors",
        *sorted(cache.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)[:5],
    ]
    raw: dict[str, str] = {}
    for c in candidates:
        data = _read_json(c)
        if not data:
            # plain text color0=...
            if c.is_file() and c.suffix != ".json":
                for line in c.read_text(errors="ignore").splitlines():
                    if "=" in line:
                        k, v = line.split("=", 1)
                        hx = _norm_hex(v.strip())
                        if hx:
                            raw[k.strip()] = hx
            continue
        # various shapes
        if "colors" in data and isinstance(data["colors"], dict):
            cols = data["colors"]
            for i in range(16):
                key = f"color{i}"
                val = cols.get(key) or cols.get(str(i))
                if isinstance(val, dict):
                    val = val.get("hex") or val.get("color")
                hx = _norm_hex(val if isinstance(val, str) else None)
                if hx:
                    raw[key] = hx
        for i in range(16):
            key = f"color{i}"
            if key in data:
                hx = _norm_hex(str(data[key]))
                if hx:
                    raw[key] = hx
        for special in ("background", "foreground", "cursor", "special"):
            if special in data:
                val = data[special]
                if isinstance(val, dict):
                    val = val.get("background") or val.get("foreground") or val.get("hex")
                hx = _norm_hex(str(val) if val else None)
                if hx:
                    if special == "background":
                        raw["bg"] = hx
                    elif special == "foreground":
                        raw["fg"] = hx
                    elif special == "cursor":
                        raw["cursor"] = hx
        if len([k for k in raw if k.startswith("color")]) >= 8:
            break
    if len([k for k in raw if k.startswith("color")]) < 4:
        return None
    return ensure_full_palette(raw), "wallust"


def extract_matugen(image: Path) -> tuple[dict[str, str], str] | None:
    import json

    if not shutil.which("matugen"):
        return None
    data = None
    for cmd in (
        ["matugen", "image", str(image), "--json", "hex", "-m", "dark"],
        ["matugen", "image", str(image), "--json", "hex"],
        ["matugen", "image", str(image), "-j", "hex", "-m", "dark"],
    ):
        try:
            proc = subprocess.run(cmd, check=True, capture_output=True, text=True, timeout=120)
            data = json.loads(proc.stdout)
            break
        except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired, ValueError):
            continue
    if data is None:
        return None

    raw: dict[str, str] = {}
    # Material You JSON: colors.dark.background etc. or colors.amoled
    colors = data.get("colors") or data
    scheme = None
    if isinstance(colors, dict):
        for key in ("dark", "tonalspot", "tonal_spot", "scheme-tonal-spot", "amoled", "dark_medium"):
            if key in colors and isinstance(colors[key], dict):
                scheme = colors[key]
                break
        if scheme is None:
            # first nested dict with background
            for v in colors.values():
                if isinstance(v, dict) and ("background" in v or "primary" in v):
                    scheme = v
                    break
        if scheme is None and "background" in colors:
            scheme = colors
    if not isinstance(scheme, dict):
        return None

    def g(*names: str) -> str | None:
        for n in names:
            if n in scheme:
                return _norm_hex(str(scheme[n]))
        return None

    bg = g("background", "surface", "surface_dim")
    fg = g("on_background", "on_surface", "on_surface_variant")
    primary = g("primary", "primary_container", "secondary")
    error = g("error", "error_container")
    if bg:
        raw["bg"] = bg
    if fg:
        raw["fg"] = fg
    if primary:
        raw["accent"] = primary
    if error:
        raw["urgent"] = error
    # Map material roles into 16-ish colors
    roles = [
        ("color0", bg),
        ("color1", error or g("error")),
        ("color2", g("tertiary", "secondary")),
        ("color3", g("tertiary_container", "secondary_container")),
        ("color4", primary),
        ("color5", g("secondary", "primary_fixed")),
        ("color6", g("tertiary", "primary_container")),
        ("color7", fg),
    ]
    for key, val in roles:
        if val:
            raw[key] = val
    if len(raw) < 4:
        return None
    return ensure_full_palette(raw), "matugen"


def extract_pywal(image: Path) -> tuple[dict[str, str], str] | None:
    wal = shutil.which("wal")
    if not wal:
        return None
    # -i image -n no wallpaper -e skip term reload -t skip tty -s skip sequences (varies by version)
    for cmd in (
        [wal, "-i", str(image), "-n", "-e", "-t", "-s", "-q"],
        [wal, "-i", str(image), "-n", "-e", "-t", "-q"],
        [wal, "-i", str(image), "-n", "-q"],
    ):
        try:
            subprocess.run(cmd, check=True, capture_output=True, timeout=120)
            break
        except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired):
            continue
    else:
        return None

    data = _read_json(Path.home() / ".cache" / "wal" / "colors.json")
    if not data:
        # colors file plain lines
        plain = Path.home() / ".cache" / "wal" / "colors"
        raw = {}
        if plain.is_file():
            lines = [ln.strip() for ln in plain.read_text().splitlines() if ln.strip()]
            for i, ln in enumerate(lines[:16]):
                hx = _norm_hex(ln)
                if hx:
                    raw[f"color{i}"] = hx
        if len(raw) < 8:
            return None
        return ensure_full_palette(raw), "pywal"

    raw: dict[str, str] = {}
    cols = data.get("colors") or {}
    for i in range(16):
        key = f"color{i}"
        hx = _norm_hex(cols.get(key))
        if hx:
            raw[key] = hx
    special = data.get("special") or {}
    for src, dst in (("background", "bg"), ("foreground", "fg"), ("cursor", "cursor")):
        hx = _norm_hex(special.get(src))
        if hx:
            raw[dst] = hx
    if len([k for k in raw if k.startswith("color")]) < 8:
        return None
    return ensure_full_palette(raw), "pywal"


def _load_png_pixels(path: Path) -> list[tuple[int, int, int]] | None:
    """Minimal PNG reader (8-bit RGB/RGBA, non-interlaced)."""
    import struct
    import zlib

    data = path.read_bytes()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    pos = 8
    width = height = None
    bit_depth = color_type = None
    idat = bytearray()
    while pos + 8 <= len(data):
        length = struct.unpack(">I", data[pos : pos + 4])[0]
        tag = data[pos + 4 : pos + 8]
        chunk = data[pos + 8 : pos + 8 + length]
        pos += 12 + length
        if tag == b"IHDR":
            width, height, bit_depth, color_type = struct.unpack(">IIBB", chunk[:10])
        elif tag == b"IDAT":
            idat.extend(chunk)
        elif tag == b"IEND":
            break
    if not width or not height or bit_depth != 8 or color_type not in (2, 6):
        return None
    try:
        raw = zlib.decompress(bytes(idat))
    except zlib.error:
        return None
    bpp = 3 if color_type == 2 else 4
    stride = width * bpp + 1
    pixels: list[tuple[int, int, int]] = []
    prev = bytearray(width * bpp)
    for y in range(height):
        row = raw[y * stride : (y + 1) * stride]
        if len(row) < stride:
            return None
        filt, data_row = row[0], bytearray(row[1:])
        if filt == 1:  # Sub
            for i in range(len(data_row)):
                left = data_row[i - bpp] if i >= bpp else 0
                data_row[i] = (data_row[i] + left) & 255
        elif filt == 2:  # Up
            for i in range(len(data_row)):
                data_row[i] = (data_row[i] + prev[i]) & 255
        elif filt == 3:  # Average
            for i in range(len(data_row)):
                left = data_row[i - bpp] if i >= bpp else 0
                up = prev[i]
                data_row[i] = (data_row[i] + ((left + up) // 2)) & 255
        elif filt == 4:  # Paeth
            for i in range(len(data_row)):
                a = data_row[i - bpp] if i >= bpp else 0
                b = prev[i]
                c = prev[i - bpp] if i >= bpp else 0
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                pr = a if pa <= pb and pa <= pc else (b if pb <= pc else c)
                data_row[i] = (data_row[i] + pr) & 255
        elif filt != 0:
            return None
        prev = data_row
        for x in range(0, width * bpp, bpp):
            pixels.append((data_row[x], data_row[x + 1], data_row[x + 2]))
    return pixels


def _quantize_colors(pixels: list[tuple[int, int, int]], k: int = 8) -> list[str]:
    """Simple iterative quantization for dominant colors."""
    if not pixels:
        return ["#1d2021"] * k
    # sample
    step = max(1, len(pixels) // 4000)
    sample = pixels[::step]
    # seed centroids on a grid of brightness
    sample_sorted = sorted(sample, key=lambda p: 0.2126 * p[0] + 0.7152 * p[1] + 0.0722 * p[2])
    centroids = [sample_sorted[int(i * (len(sample_sorted) - 1) / max(k - 1, 1))] for i in range(k)]
    for _ in range(8):
        buckets: list[list[tuple[int, int, int]]] = [[] for _ in range(k)]
        for p in sample:
            bi = min(
                range(k),
                key=lambda i: (p[0] - centroids[i][0]) ** 2
                + (p[1] - centroids[i][1]) ** 2
                + (p[2] - centroids[i][2]) ** 2,
            )
            buckets[bi].append(p)
        new_c = []
        for i, bucket in enumerate(buckets):
            if not bucket:
                new_c.append(centroids[i])
            else:
                n = len(bucket)
                new_c.append(
                    (
                        sum(p[0] for p in bucket) // n,
                        sum(p[1] for p in bucket) // n,
                        sum(p[2] for p in bucket) // n,
                    )
                )
        centroids = new_c
    # sort dark → light
    centroids = sorted(centroids, key=lambda p: 0.2126 * p[0] + 0.7152 * p[1] + 0.0722 * p[2])
    return [_rgb_hex(*c) for c in centroids]


def extract_builtin(image: Path) -> tuple[dict[str, str], str] | None:
    """Always-available extractor for PNG (and PPM via convert if needed)."""
    path = image
    pixels = None
    if path.suffix.lower() == ".png":
        pixels = _load_png_pixels(path)
    if pixels is None:
        # try ImageMagick → PPM
        for conv in ("magick", "convert"):
            if not shutil.which(conv):
                continue
            import tempfile as tf

            with tf.NamedTemporaryFile(suffix=".ppm", delete=False) as tmp:
                ppm = Path(tmp.name)
            try:
                cmd = [conv, str(path), "-resize", "200x200", str(ppm)]
                if conv == "magick":
                    cmd = [conv, str(path), "-resize", "200x200", str(ppm)]
                subprocess.run(cmd, check=True, capture_output=True, timeout=60)
                text = ppm.read_bytes()
                # parse binary PPM P6
                if text.startswith(b"P6"):
                    parts = text.split(b"\n", 3)
                    # handle comments
                    body = text[2:]
                    tokens = []
                    i = 0
                    while len(tokens) < 3 and i < len(body):
                        while i < len(body) and body[i : i + 1] in b" \t\n\r":
                            i += 1
                        if i < len(body) and body[i : i + 1] == b"#":
                            while i < len(body) and body[i : i + 1] != b"\n":
                                i += 1
                            continue
                        j = i
                        while j < len(body) and body[j : j + 1] not in b" \t\n\r":
                            j += 1
                        tokens.append(body[i:j])
                        i = j
                    w, h = int(tokens[0]), int(tokens[1])
                    # maxval then data
                    while i < len(body) and body[i : i + 1] in b" \t\n\r":
                        i += 1
                    j = i
                    while j < len(body) and body[j : j + 1] not in b" \t\n\r":
                        j += 1
                    i = j + 1  # skip maxval newline
                    raw = body[i:]
                    pixels = [
                        (raw[n], raw[n + 1], raw[n + 2])
                        for n in range(0, min(len(raw), w * h * 3), 3)
                    ]
            except Exception:
                pixels = None
            finally:
                try:
                    ppm.unlink()
                except OSError:
                    pass
            if pixels:
                break
    if not pixels:
        return None
    dom = _quantize_colors(pixels, 8)
    raw = {
        "bg": dom[0],
        "color0": dom[0],
        "color1": dom[min(1, len(dom) - 1)],
        "color2": dom[min(2, len(dom) - 1)],
        "color3": dom[min(3, len(dom) - 1)],
        "color4": dom[min(4, len(dom) - 1)],
        "color5": dom[min(5, len(dom) - 1)],
        "color6": dom[min(6, len(dom) - 1)],
        "color7": dom[-1],
        "fg": dom[-1],
        "accent": dom[min(4, len(dom) - 1)],
        "urgent": dom[min(1, len(dom) - 1)],
    }
    return ensure_full_palette(raw), "builtin"


def extract_palette(image: Path, prefer: str | None = None) -> tuple[dict[str, str], str]:
    """Locked order: wallust → matugen → pywal → builtin."""
    order = [
        ("wallust", extract_wallust),
        ("matugen", extract_matugen),
        ("pywal", extract_pywal),
        ("builtin", extract_builtin),
    ]
    if prefer:
        order = [o for o in order if o[0] == prefer] + [o for o in order if o[0] != prefer]
    errors: list[str] = []
    for name, fn in order:
        try:
            result = fn(image)
            if result:
                print(f"==> extracted palette with {result[1]}")
                return result
            errors.append(f"{name}: no usable palette")
        except Exception as e:
            errors.append(f"{name}: {e}")
    for e in errors:
        print(f"voidwolf-theme: {e}", file=sys.stderr)
    raise RuntimeError("all extraction backends failed")


def cmd_from_wallpaper(args: list[str]) -> int:
    """from-wallpaper <path> [--name derived-slug] [--backend wallust|matugen|pywal|builtin] [--no-apply]"""
    if not args:
        print(
            "Usage: voidwolf-theme from-wallpaper <path> [--name NAME] [--backend B] [--no-apply]",
            file=sys.stderr,
        )
        return 1

    image_s = args[0]
    name: str | None = None
    backend: str | None = None
    no_apply = False
    i = 1
    while i < len(args):
        if args[i] == "--name" and i + 1 < len(args):
            name = args[i + 1]
            i += 2
        elif args[i] == "--backend" and i + 1 < len(args):
            backend = args[i + 1]
            i += 2
        elif args[i] == "--no-apply":
            no_apply = True
            i += 1
        else:
            print(f"voidwolf-theme: unknown arg: {args[i]}", file=sys.stderr)
            return 1

    image = Path(image_s).expanduser().resolve()
    if not image.is_file():
        print(f"voidwolf-theme: image not found: {image}", file=sys.stderr)
        return 2

    if backend and backend not in ("wallust", "matugen", "pywal", "builtin"):
        print("voidwolf-theme: --backend must be wallust|matugen|pywal|builtin", file=sys.stderr)
        return 1

    try:
        pal, used = extract_palette(image, prefer=backend)
    except RuntimeError as e:
        print(f"voidwolf-theme: {e}", file=sys.stderr)
        return 3

    slug = name or f"derived-{slugify_name(image.stem)}"
    if not slug.startswith("derived-") and name is None:
        slug = f"derived-{slug}"
    # sanitize name
    slug = re.sub(r"[^a-zA-Z0-9._-]+", "-", slug).strip("-")

    theme = {
        "schema_version": 1,
        "name": slug,
        "display_name": f"Derived ({image.stem}) [{used}]",
        "author": "voidwolf-derived",
        "description": f"Extracted from {image} via {used}",
        "palette": pal,
        "meta": {
            "gtk_theme": "Adwaita-dark",
            "icon_theme": "Adwaita",
            "cursor_theme": "Adwaita",
            "cursor_size": 24,
            "wallpaper": str(image),
        },
        "options": {"dwm_border_px": 2, "dwm_showbar": True},
    }

    errs = validate_theme(theme, strict_ansi=True)
    if errs:
        # should not happen after ensure_full_palette
        for e in errs:
            print(f"error: {e}", file=sys.stderr)
        return 4

    out_dir = voidwolf_home() / "themes"
    out_dir.mkdir(parents=True, exist_ok=True)
    out_path = out_dir / f"{slug}.toml"
    atomic_write(out_path, dump_theme_toml(theme))
    print(f"==> wrote {out_path}")

    if no_apply:
        print("==> --no-apply: not applying theme")
        return 0
    apply_adapters(theme)
    return 0


def usage() -> None:
    print(
        """voidwolf-theme — manage voidwolf color themes

Usage:
  voidwolf-theme list
  voidwolf-theme show [name]
  voidwolf-theme current
  voidwolf-theme set <name>
  voidwolf-theme pick
  voidwolf-theme validate [path|name]
  voidwolf-theme build-suckless
  voidwolf-theme reload
  voidwolf-theme from-wallpaper <path> [--name NAME] [--backend B] [--no-apply]

from-wallpaper backends (auto, locked order):
  wallust → matugen → pywal → builtin (PNG quantizer)

Exit: 0 ok, 1 usage, 2 not found, 3 adapter failure, 4 schema invalid

Paths:
  VOIDWOLF_HOME  default ~/.config/voidwolf
  VOIDWOLF_ROOT  repo root (themes/, suckless/)
"""
    )


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        usage()
        return 0 if len(argv) > 1 else 1
    cmd = argv[1]
    args = argv[2:]
    table = {
        "list": cmd_list,
        "show": cmd_show,
        "current": cmd_current,
        "set": cmd_set,
        "pick": cmd_pick,
        "validate": cmd_validate,
        "build-suckless": cmd_build_suckless,
        "reload": cmd_reload,
        "from-wallpaper": cmd_from_wallpaper,
    }
    if cmd not in table:
        usage()
        return 1
    try:
        return table[cmd](args)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
