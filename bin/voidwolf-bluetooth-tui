#!/bin/sh
# Super+Ctrl+B — bluetooth (floating centered TUI)
export PATH="${HOME}/.local/bin:${PATH}"

run_st() {
	label="$1"
	shift
	if command -v voidwolf-float-term >/dev/null 2>&1; then
		exec voidwolf-float-term "$label" -- "$@"
	fi
	if command -v st >/dev/null 2>&1; then
		exec st -t "voidwolf-tui:$label" -g "${VOIDWOLF_TUI_GEOM:-100x30}" -e "$@"
	fi
	exec "$@"
}

# Soft check: is the stack present?
if command -v bluetoothctl >/dev/null 2>&1; then
	if ! bluetoothctl show >/dev/null 2>&1; then
		command -v notify-send >/dev/null 2>&1 && \
			notify-send "voidwolf" "Bluetooth: controller offline? check bluetoothd"
	fi
fi

if command -v bluetuith >/dev/null 2>&1; then
	run_st bluetooth bluetuith
fi
if command -v bluetui >/dev/null 2>&1; then
	run_st bluetooth bluetui
fi
if command -v blueberry >/dev/null 2>&1; then
	exec blueberry
fi
if command -v bluetoothctl >/dev/null 2>&1; then
	run_st bluetooth bluetoothctl
fi

echo "voidwolf-bluetooth-tui: install bluez (bluetoothctl) or bluetuith" >&2
command -v notify-send >/dev/null 2>&1 && notify-send "voidwolf" "Bluetooth tools missing"
exit 1
