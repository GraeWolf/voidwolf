#!/bin/sh
# voidwolf-volume — PipeWire volume via wpctl (XF86 media keys / menus)
# Usage: voidwolf-volume {up|down|mute|get}
set -e

export PATH="${HOME}/.local/bin:${PATH}"
STEP="${VOIDWOLF_VOLUME_STEP:-5}"

if ! command -v wpctl >/dev/null 2>&1; then
	echo "voidwolf-volume: wpctl not found (install wireplumber)" >&2
	exit 1
fi

case "${1:-}" in
	up|+)
		wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}%+"
		;;
	down|-)
		wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}%-"
		;;
	mute|toggle)
		wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
		;;
	get|status|"")
		wpctl get-volume @DEFAULT_AUDIO_SINK@
		;;
	*)
		echo "Usage: voidwolf-volume {up|down|mute|get}" >&2
		exit 2
		;;
esac
