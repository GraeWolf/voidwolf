#!/bin/sh
# voidwolf-screenshot — capture (Print / Super+Ctrl+C)
# Requires maim; prefers xclip for clipboard copy.
set -e

export PATH="${HOME}/.local/bin:${PATH}"

mode="${1:-menu}"
dir="${VOIDWOLF_SCREENSHOT_DIR:-$HOME/Pictures/Screenshots}"
mkdir -p "$dir"
stamp=$(date +%Y%m%d-%H%M%S)
file="$dir/voidwolf-$stamp.png"

notify() {
	command -v notify-send >/dev/null 2>&1 && notify-send -a voidwolf "Screenshot" "$1"
}

dmenu_pick() {
	if command -v voidwolf-dmenu >/dev/null 2>&1; then
		voidwolf-dmenu -i -p "capture:"
	else
		dmenu -i -p "capture:"
	fi
}

need_maim() {
	if ! command -v maim >/dev/null 2>&1; then
		echo "voidwolf-screenshot: maim not found" >&2
		notify "Install maim for screenshots"
		exit 1
	fi
}

copy_clip() {
	if command -v xclip >/dev/null 2>&1; then
		xclip -selection clipboard -t image/png -i "$1" 2>/dev/null || true
	fi
}

do_full() {
	need_maim
	maim "$file"
	copy_clip "$file"
	notify "Full screen → $file"
}

do_region() {
	need_maim
	# -s select; -u hide cursor; fail cleanly if cancelled
	if maim -s -u "$file" 2>/dev/null; then
		copy_clip "$file"
		notify "Region → $file"
	else
		notify "Region capture cancelled"
		exit 0
	fi
}

do_window() {
	need_maim
	if command -v xdotool >/dev/null 2>&1; then
		wid=$(xdotool getactivewindow 2>/dev/null) || wid=
		if [ -n "$wid" ]; then
			maim -i "$wid" "$file"
			copy_clip "$file"
			notify "Window → $file"
			return
		fi
	fi
	do_region
}

do_menu() {
	choice=$(printf '%s\n' \
		"Full screen" \
		"Region" \
		"Active window" \
		"Cancel" | dmenu_pick) || exit 0
	case "$choice" in
		"Full screen") do_full ;;
		"Region") do_region ;;
		"Active window") do_window ;;
		*) exit 0 ;;
	esac
}

case "$mode" in
	menu|capture) do_menu ;;
	full) do_full ;;
	region|sel) do_region ;;
	window|win) do_window ;;
	*)
		echo "Usage: voidwolf-screenshot [menu|full|region|window]" >&2
		exit 2
		;;
esac
