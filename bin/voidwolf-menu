#!/bin/sh
# voidwolf-menu — control menu (Super+Alt+Space)
# Omarchy-like quick actions without a heavy DE.

export PATH="${HOME}/.local/bin:${PATH}"

dmenu_pick() {
	prompt="${1:-voidwolf:}"
	if command -v voidwolf-dmenu >/dev/null 2>&1; then
		voidwolf-dmenu -i -p "$prompt"
	else
		dmenu -i -p "$prompt"
	fi
}

run_bg() {
	"$@" >/dev/null 2>&1 &
}

choice=$(printf '%s\n' \
	"Launcher" \
	"Terminal" \
	"Browser" \
	"File manager" \
	"Neovim" \
	"Screenshot" \
	"Theme" \
	"Wallpaper" \
	"Audio" \
	"Bluetooth" \
	"Wi-Fi" \
	"System monitor" \
	"Keybindings" \
	"Clipboard" \
	"System menu" \
	"Lock" \
	"Cancel" | dmenu_pick) || exit 0

case "$choice" in
	"Launcher") exec voidwolf-launcher ;;
	"Terminal") exec st ;;
	"Browser") exec voidwolf-browser ;;
	"File manager") exec voidwolf-filemanager ;;
	"Neovim") exec st -e nvim ;;
	"Screenshot") exec voidwolf-screenshot menu ;;
	"Theme")
		if command -v voidwolf-theme >/dev/null 2>&1; then
			exec voidwolf-theme pick
		fi
		;;
	"Wallpaper")
		if command -v voidwolf-wallpaper >/dev/null 2>&1; then
			exec voidwolf-wallpaper pick
		fi
		;;
	"Audio") exec voidwolf-audio-tui ;;
	"Bluetooth") exec voidwolf-bluetooth-tui ;;
	"Wi-Fi") exec voidwolf-wifi-tui ;;
	"System monitor") exec st -e btop ;;
	"Keybindings") exec voidwolf-cheatsheet ;;
	"Clipboard") exec voidwolf-clipboard ;;
	"System menu") exec voidwolf-system-menu ;;
	"Lock") exec voidwolf-lock ;;
	*) exit 0 ;;
esac
