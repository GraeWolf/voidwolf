#!/bin/sh
# voidwolf example: secondary monitor physically LEFT of primary
# Prefer absolute --pos (more reliable than --left-of on NVIDIA).
#
# Edit output names / modes for your machine (xrandr --query).
set -e

LEFT="${VOIDWOLF_DISPLAY_LEFT:-HDMI-1}"     # physical left
RIGHT="${VOIDWOLF_DISPLAY_RIGHT:-HDMI-0}"   # physical right (primary)
LEFT_MODE="${VOIDWOLF_DISPLAY_LEFT_MODE:-1920x1080}"
RIGHT_MODE="${VOIDWOLF_DISPLAY_RIGHT_MODE:-2560x1440}"
LEFT_Y="${VOIDWOLF_DISPLAY_LEFT_Y:-0}"      # e.g. 180 to vertically center 1080 on 1440

if ! xrandr --query | grep -q "^${LEFT} connected"; then
	echo "left output not connected: $LEFT" >&2
	exit 1
fi
if ! xrandr --query | grep -q "^${RIGHT} connected"; then
	echo "right/primary not connected: $RIGHT" >&2
	exit 1
fi

LEFT_W=${LEFT_MODE%x*}

xrandr \
	--output "$LEFT"  --mode "$LEFT_MODE"  --pos "0x${LEFT_Y}" \
	--output "$RIGHT" --mode "$RIGHT_MODE" --pos "${LEFT_W}x0" --primary
