# voidwolf ISO build environment (copy to iso/mklive.env and edit)
# Sourced by iso/build-iso.sh — never commit secrets.

# Path to a checkout of https://github.com/void-linux/void-mklive
# VOID_MKLIVE_DIR="$HOME/src/void-mklive"

# Architecture (Phase 1–5: glibc x86_64 first)
VOIDWOLF_ISO_ARCH=x86_64

# Output directory (default: iso/out under this repo)
# VOIDWOLF_ISO_OUT="$PWD/iso/out"

# Image basename (void-mklive appends date/arch as configured)
VOIDWOLF_ISO_BASE=voidwolf

# Live / installed hostname (design locked)
VOIDWOLF_HOSTNAME=voidwolf

# Default interactive user created on live image / firstboot notes
VOIDWOLF_LIVE_USER=voidwolf

# Include local packages/repo in the image build (requires ./packages/build-local-repo.sh first)
VOIDWOLF_ISO_INCLUDE_LOCAL_REPO=1

# Extra XBPS repositories (space-separated URLs), e.g. XLibre release URL after repos.sh pins
# VOIDWOLF_ISO_EXTRA_REPOS=""

# void-mklive extra free-form args (appended last)
# VOIDWOLF_MKLIVE_EXTRA_ARGS=""
